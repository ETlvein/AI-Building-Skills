{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ETlvein/AI-Building-Skills/schemas/SKILL_MANIFEST.schema.json",
  "title": "AI-Building Skill Manifest",
  "description": "Schema for permanently retained, independently governed reusable Skills.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "skill",
    "governance",
    "classification",
    "source",
    "resolution",
    "dependencies",
    "composition",
    "lifecycle",
    "compatibility",
    "publication",
    "updated_date"
  ],

  "properties": {

    "schema_version": {
      "type": "integer",
      "const": 1
    },

    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "scope",
        "status",
        "path",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "scope": {
          "type": "string",
          "enum": [
            "GLOBAL",
            "DOMAIN"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "AVAILABLE",
            "INACTIVE",
            "QUARANTINED"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_standard_repository",
        "prompt_standard_ref",
        "prompt_standard_id"
      ],
      "properties": {
        "prompt_standard_repository": {
          "type": "string",
          "minLength": 1
        },
        "prompt_standard_ref": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "prompt_standard_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "tags"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "source_url",
        "external_identifier",
        "external_version_or_commit",
        "content_hash"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "external_identifier": {
          "type": "string"
        },
        "external_version_or_commit": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        }
      }
    },

    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_discoverable",
        "load_policy"
      ],
      "properties": {
        "registry_discoverable": {
          "type": "boolean"
        },
        "load_policy": {
          "type": "string",
          "enum": [
            "ON_DEMAND"
          ]
        }
      }
    },

    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "references",
        "skills"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "conflicts_with",
        "similar_to",
        "alternative_to",
        "newer_than",
        "exclusive_groups",
        "precedence",
        "unknown_compatibility_action"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "COMPOSABLE",
            "STANDALONE"
          ]
        },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "similar_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alternative_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "newer_than": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusive_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "precedence": {
          "type": "string",
          "enum": [
            "LOW",
            "NORMAL",
            "HIGH"
          ]
        },
        "unknown_compatibility_action": {
          "type": "string",
          "const": "BLOCK_UNTIL_EVALUATED"
        }
      }
    },

    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permanent_retention",
        "deletion_allowed",
        "merge_allowed",
        "historical_version_overwrite_allowed",
        "identity_preserved",
        "independent_directory_required",
        "independent_version_history_required"
      ],
      "properties": {
        "permanent_retention": {
          "type": "boolean",
          "const": true
        },
        "deletion_allowed": {
          "type": "boolean",
          "const": false
        },
        "merge_allowed": {
          "type": "boolean",
          "const": false
        },
        "historical_version_overwrite_allowed": {
          "type": "boolean",
          "const": false
        },
        "identity_preserved": {
          "type": "boolean",
          "const": true
        },
        "independent_directory_required": {
          "type": "boolean",
          "const": true
        },
        "independent_version_history_required": {
          "type": "boolean",
          "const": true
        }
      }
    },

    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environments",
        "minimum_prompt_standard"
      ],
      "properties": {
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum_prompt_standard": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },

    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_safe",
        "published"
      ],
      "properties": {
        "public_safe": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        }
      }
    },

    "updated_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
